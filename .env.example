PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/codejudge
JWT_SECRET=replace_with_a_random_string

# Groq API key, used for AI code review (backend/services/ai.service.js)
GROQ_API_KEY=

# --- Multi-language execution (optional) ---
# JavaScript submissions always run locally in the isolated-vm sandbox and
# need none of this. Python/C++/Java submissions run inside an E2B sandbox
# (a real, ephemeral Linux VM) instead. To enable them:
#
#   1. Sign up for free at https://e2b.dev — Hobby tier gives $100 in
#      credit, no credit card required.
#   2. Copy your API key from the E2B dashboard.
E2B_API_KEY=
